# Local CMS database. The default port avoids colliding with a system MySQL on 3306.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=portfolio
DB_PASSWORD=portfolio_local
DB_NAME=portfolio_cms
MYSQL_ROOT_PASSWORD=portfolio_local_root

# Local API and uploaded files.
API_HOST=127.0.0.1
API_PORT=8787
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=50

# Leave as /api for the Vite proxy. For a deployed API, use an absolute URL.
PUBLIC_API_URL=/api
