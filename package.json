{
  "name": "portfolio-v2",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "astro dev",
    "dev:api": "node --watch server/index.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint . --max-warnings 0",
    "db:up": "docker compose up -d mysql",
    "db:down": "docker compose down",
    "db:setup": "node server/scripts/setup-db.mjs",
    "test": "node --test server/tests/*.test.mjs && node --import tsx --test tests/*.test.ts",
    "test:server": "node --test server/tests/*.test.mjs",
    "test:web": "node --import tsx --test tests/*.test.ts",
    "astro": "astro"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-navigation-menu": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.2.0",
    "astro": "^5.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "lenis": "^1.1.0",
    "lucide-react": "^0.460.0",
    "motion": "^11.0.0",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/react": "^4.4.2",

    "@astrojs/tailwind": "^6.0.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "astro-eslint-parser": "^1.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "framer-motion": "11.18.2",
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0"
  }
}
